      "x": -12628.51776700894,
      "y": 10692.260470338695,
      "width": 741.3655437281778,
      "height": 244.03772807583428,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
