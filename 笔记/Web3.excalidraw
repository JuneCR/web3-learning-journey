      "text": "高成交量 = 今日成交量 > 过去10天平均成交量；",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "高成交量 = 今日成交量 > 过去10天平均成交量；",
