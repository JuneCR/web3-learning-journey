    },
    {
      "id": "9mJIwE2K3SOBzDLfwmR2_",
      "type": "text",
      "x": 17565.570312621127,
      "y": 449.6776210239982,
      "width": 766.66680908203,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRt4",
      "roundness": null,
      "seed": 964030402,
      "version": 362,
      "versionNonce": 1207732873,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "孕线形态出现时，可能预示着趋势反转。\n\n孕线形态分为两种类型：看涨孕线和看跌孕线。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "孕线形态出现时，可能预示着趋势反转。\n\n孕线形态分为两种类型：看涨孕线和看跌孕线。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "WkURuqQPgMpVsjvmqyKCg",
      "type": "text",
      "x": 17492.903534056673,
      "y": 692.1777583530998,
      "width": 144,
      "height": 45,
      "angle": 0,
