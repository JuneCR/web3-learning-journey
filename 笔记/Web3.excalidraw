    {
      "id": "YE_Zz6sz1mlqKEFHm4t-7",
      "type": "text",
      "x": 129.83331044514978,
      "y": 893.8888346354166,
      "width": 214.0199432373047,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
