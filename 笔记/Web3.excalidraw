      "version": 181,
      "versionNonce": 35963753,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "如上文   1.之前的趋势是上涨\n          \n          2.顶部出来看跌吞没\n \n          3.P2之后出现了十字星",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "如上文   1.之前的趋势是上涨\n          \n          2.顶部出来看跌吞没\n \n          3.P2之后出现了十字星",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ApqksoagvYZZ8XWINwMyB",
      "type": "text",
      "x": 16205.955458868124,
      "y": 915.1504102434426,
      "width": 252,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsb",
      "roundness": null,
      "seed": 838703733,
      "version": 75,
      "versionNonce": 839533479,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "这是做空的良机",
