      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "吊颈线形态为看跌形态，而锤子线形态则相对看涨",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "吊颈线形态为看跌形态，而锤子线形态则相对看涨",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "WkIbp11BqMA-SR_9fQyE5",
      "type": "text",
      "x": 12019.346852741572,
      "y": 1008.3438790941991,
      "width": 684,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
