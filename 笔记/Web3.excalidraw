      "versionNonce": 1950982057,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "对于短线交易，形态的高点应该在阻力位附近。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "对于短线交易，形态的高点应该在阻力位附近。",
      "autoResize": true,
