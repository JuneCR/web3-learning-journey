    },
    {
      "id": "T_SsQcs2qsU-ACL-YIUBD",
      "type": "text",
      "x": 10291.053976180065,
      "y": 1532.769341605051,
      "width": 634.0679931640625,
      "height": 45,
      "angle": 0,
