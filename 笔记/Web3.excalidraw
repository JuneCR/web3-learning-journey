      "seed": 1592153951,
      "version": 30,
      "versionNonce": 229199847,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "如果纸伞出现在下跌行情的底部，则称为“锤子线”",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "如果纸伞出现在下跌行情的底部，则称为“锤子线”",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "KSsX64YteADVd_LYGktt-",
      "type": "text",
      "x": 12135.93086763415,
      "y": 917.8438790941991,
      "width": 960.1652832031248,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
