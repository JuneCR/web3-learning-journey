      "baseFontSize": null
    },
    {
      "id": "EE8xXyQePbK8Rd5ehxEdW",
      "type": "text",
      "x": 15990.45543597994,
      "y": 1024.4836316789895,
      "width": 144,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsc",
      "roundness": null,
      "seed": 1163991349,
      "version": 96,
      "versionNonce": 2104127049,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "图表分析",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "图表分析",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "KSlvy0nZWtJ5MWp_UKBBi",
      "type": "text",
      "x": 16104.955397832968,
      "y": 1120.316990443638,
      "width": 756,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsd",
      "roundness": null,
      "seed": 1105474683,
      "version": 90,
      "versionNonce": 930166471,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "图表中持续的上升趋势证实了多头完全掌控了市\n场。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "图表中持续的上升趋势证实了多头完全掌控了市场。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "guzLGCJ_hv2VcQj2Ue7EQ",
      "type": "text",
      "x": 16101.656768072226,
      "y": 1223.6503492082863,
      "width": 789.2639770507812,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRse",
      "roundness": null,
      "seed": 1694737589,
      "version": 58,
      "versionNonce": 477609257,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "在 P1 图表上，形成了一根蓝色蜡烛，再次确认了\n多头在市场中的主导地位。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "在 P1 图表上，形成了一根蓝色蜡烛，再次确认了多头在市场中的主导地位。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "M9Y8PlwH5q1-NrdhwUYn0",
      "type": "text",
      "x": 16098.622115362265,
      "y": 1316.1503492082863,
      "width": 792,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsf",
      "roundness": null,
      "seed": 436071707,
      "version": 146,
      "versionNonce": 1439483367,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "P2市场高开并创下新高，提振了多头信心。然\n而，在高点附近，强劲的抛售潮涌现，最终导致价\n格收盘价低于P1的开盘价。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P2市场高开并创下新高，提振了多头信心。然而，在高点附近，强劲的抛售潮涌现，最终导致价格收盘价低于P1的开盘价。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "zpmmOvS8KkBOAXRsJgyXI",
      "type": "text",
      "x": 16097.258055914022,
      "y": 1483.6503492082863,
      "width": 784.7279663085938,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsg",
      "roundness": null,
      "seed": 2130134549,
      "version": 75,
      "versionNonce": 1320693769,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "P2 的这种交易行为让多头有些恐慌，但他们还没\n有动摇。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P2 的这种交易行为让多头有些恐慌，但他们还没有动摇。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "VMrmQkUgaHx_Gu0A07ByX",
      "type": "text",
      "x": 16080.288832891561,
      "y": 1599.48378426688,
      "width": 792,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsh",
      "roundness": null,
      "seed": 60264891,
      "version": 162,
      "versionNonce": 1009348871,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "第三天，我们称之为P3，虽然开盘疲软，\n\n。这对多头来说并不太令人放心，因为他们预期市\n场会走强。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "第三天，我们称之为P3，虽然开盘疲软，\n\n。这对多头来说并不太令人放心，因为他们预期市场会走强。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "EzywYgm08iQL2hBl7k4ez",
      "type": "text",
      "x": 16086.955474126913,
      "y": 1811.98378426688,
      "width": 792,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsi",
      "roundness": null,
      "seed": 1353694069,
      "version": 126,
      "versionNonce": 170346217,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "在P3阶段，市场试图向上突破（形成十字星的上\n影线），但高点未能持续。低点也未能维持，最终\n收盘横盘整理，形成十字星形态。您可能还记得，\n十字星形态表明市场犹豫不决。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "在P3阶段，市场试图向上突破（形成十字星的上影线），但高点未能持续。低点也未能维持，最终收盘横盘整理，形成十字星形态。您可能还记得，十字星形态表明市场犹豫不决。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Te3nRA00xLN7K5yG7tm-k",
      "type": "text",
      "x": 16106.216796148397,
      "y": 2032.8170667375832,
      "width": 630.1439208984375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsj",
      "roundness": null,
      "seed": 533963355,
      "version": 166,
      "versionNonce": 67352615,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "P2 公牛惊慌失措，P3 公牛犹豫不决。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P2 公牛惊慌失措，P3 公牛犹豫不决。",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "kDbKxWZaDC1a6ybqg7kov",
      "type": "text",
      "x": 16080.288604009726,
      "y": 2137.816914149693,
      "width": 792,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRsk",
      "roundness": null,
      "seed": 846365909,
      "version": 256,
      "versionNonce": 2035319241,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "恐慌和不确定性是酿成灾难的完美配方。这也解释\n了为什么在十字星之后会出现一根长长的红色蜡烛\n线。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "恐慌和不确定性是酿成灾难的完美配方。这也解释了为什么在十字星之后会出现一根长长的红色蜡烛线。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
