      "versionNonce": 1441946503,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "看涨:表面市场对股票买盘十分感兴趣",
      "fontSize": 36,
