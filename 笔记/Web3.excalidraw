      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "1.该股票应该形成可识别的K线形态",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.该股票应该形成可识别的K线形态",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "PYKmdHkKx0I7X5mYTsSVn",
      "type": "text",
      "x": 21378.226423899257,
      "y": 7107.158876691554,
      "width": 1091.9999999999995,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
