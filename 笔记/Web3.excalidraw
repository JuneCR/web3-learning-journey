    },
    {
      "id": "wnlJ-CzCH2QlmdgePTXVj",
      "type": "text",
      "x": 13946.510833013619,
      "y": 3824.650476364862,
      "width": 529.0919799804688,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
