      "x": -8719.184881266752,
      "y": 11044.260744996898,
      "width": 741.3655437281778,
      "height": 244.03772807583428,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
