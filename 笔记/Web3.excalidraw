    {
      "id": "BlCFtbVsDYJ69ppcSpQql",
      "type": "text",
      "x": 1674.6064573015487,
      "y": 325.3254125685926,
      "width": 1188,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
