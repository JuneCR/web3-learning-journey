      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRr6",
      "roundness": null,
      "seed": 67485567,
      "version": 199,
      "versionNonce": 1458279209,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "纸伞形态的特点是下影线较长，上影线较短",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "纸伞形态的特点是下影线较长，上影线较短",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "1i3G7YWIjN-_gut5m0GLx",
      "type": "text",
      "x": 12130.893514118525,
      "y": 832.3437570238866,
      "width": 786.239990234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
