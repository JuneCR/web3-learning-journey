      "versionNonce": 929203495,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "看跌, 昏星出现之前为上升趋势,与晨星已有也是由三根K线组成",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "看跌, 昏星出现之前为上升趋势,与晨星已有也是由三根K线组成",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Bj2ffCT_OAf5kCM76bDHI",
      "type": "text",
      "x": 19413.886957420415,
      "y": 4686.103071232287,
      "width": 81.50399780273438,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
