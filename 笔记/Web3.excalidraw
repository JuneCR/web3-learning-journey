      "locked": false,
      "text": " ： 看涨形态 周期 三天",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " ： 看涨形态 周期 三天",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "WVG7tYGEZGe9blNq0ncLl",
      "type": "text",
      "x": 19355.813708744376,
      "y": 1595.6774684361078,
      "width": 932.7346801757817,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRti",
      "roundness": null,
      "seed": 1898417090,
      "version": 120,
      "versionNonce": 764464137,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "它是一种下跌趋势反转形态，由三根连续的K线构成",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "它是一种下跌趋势反转形态，由三根连续的K线构成",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "0wJLac6nHhFLz6uDLwVg4",
