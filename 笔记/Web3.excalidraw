      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "会产生一个问题  : 没有绝对  没有上影线和下影线，可能会露出一点",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "会产生一个问题  : 没有绝对  没有上影线和下影线，可能会露出一点",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
