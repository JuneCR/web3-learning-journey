    {
      "id": "WzqMdagAazjB19pGObWnD",
      "type": "text",
      "x": 16043.955458868124,
      "y": 631.1504102434426,
      "width": 514.0799560546875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
