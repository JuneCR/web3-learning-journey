      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "两个价格行为区域之间的距离越大，支撑阻力位识别的有效性就越高。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "两个价格行为区域之间的距离越大，支撑阻力位识别的有效性就越高。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
