      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "dsIKYOoTwvCMaaHEaDPD5",
      "type": "text",
      "x": 12020.013478718134,
      "y": 753.6771310473241,
      "width": 792,
      "height": 45,
