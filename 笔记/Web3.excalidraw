      "index": "cRsL",
      "roundness": null,
      "seed": 1495616795,
      "version": 127,
      "versionNonce": 2143066791,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "1.先前的趋势应该是上涨\n\n2.P1应该是蓝色   P2应该是红色",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.先前的趋势应该是上涨\n\n2.P1应该是蓝色   P2应该是红色",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "hbvoyVCq6OJgJO-qXPpLA",
      "type": "text",
      "x": 13763.177512395943,
      "y": 4484.650628952752,
      "width": 81.50399780273438,
      "height": 45,
