    {
      "id": "zn_pXg7xuZ60YEDFC3Spr",
      "type": "text",
      "x": 17872.236984374056,
      "y": 2948.5111628941154,
      "width": 573.2279663085938,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
