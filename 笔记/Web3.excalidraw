    },
    {
      "id": "F6AS9kS7KnX6TiKnAFSIH",
      "type": "text",
      "x": 2317.9397092546737,
      "y": 595.3254125685926,
      "width": 223.77598571777344,
      "height": 45,
      "angle": 0,
