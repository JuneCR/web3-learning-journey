      "link": null,
      "locked": false,
      "text": "纸伞形态由两种趋势反转形态组成，即吊颈线和锤子线",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "纸伞形态由两种趋势反转形态组成，即吊颈线和锤子线",
      "autoResize": false,
