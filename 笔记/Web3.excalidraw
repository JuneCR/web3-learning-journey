    },
    {
      "id": "u4b_T0wCS04WPkYFnpvjx",
      "type": "text",
      "x": 19374.84767480883,
      "y": 240.8440944126703,
      "width": 1187.783935546875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRtc",
      "roundness": null,
      "seed": 229456002,
      "version": 445,
      "versionNonce": 335011689,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "指买方热情高涨 , 跳空就是 P1的收盘为100, 收盘后该公司发布了季度报告\n\n季度报告非常亮眼，买家愿意以任何价格买入该股票,第二天买入为104，\n\n100 - 104没有任何交易活动,却跳空高开到 104",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "指买方热情高涨 , 跳空就是 P1的收盘为100, 收盘后该公司发布了季度报告\n\n季度报告非常亮眼，买家愿意以任何价格买入该股票,第二天买入为104，\n\n100 - 104没有任何交易活动,却跳空高开到 104",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
