      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "确定目标价格的最佳方法是找到支撑位和阻力位",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "确定目标价格的最佳方法是找到支撑位和阻力位",
      "autoResize": true,
