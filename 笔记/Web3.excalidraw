    },
    {
      "id": "3D-A7cO2NiDm57fEQqN1n",
      "type": "text",
      "x": 27269.488307043302,
      "y": 1738.9065666238434,
      "width": 486.79193115234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
