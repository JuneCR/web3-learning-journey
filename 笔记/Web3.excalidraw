    },
    {
      "id": "IjFUQ4peztOMUFUiplMqa",
      "type": "text",
      "x": 24956.12949631267,
      "y": 1177.658499099085,
      "width": 1014.1537778293648,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRvy",
      "roundness": null,
      "seed": 442353278,
      "version": 240,
      "versionNonce": 1369155913,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "采用最新的数据点并舍弃最旧的数据点来计算最新的5日平均值",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "采用最新的数据点并舍弃最旧的数据点来计算最新的5日平均值",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "YyGbXvsHSqzSQQN-QncDm",
      "type": "text",
      "x": 24960.835991030974,
      "y": 1277.8761589246956,
      "width": 1009.2959594726562,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRvz",
      "roundness": null,
      "seed": 236975074,
      "version": 179,
      "versionNonce": 1715809223,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "我们是根据5个交易日的数据计算的 被称为 5日简单移动平均线",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "我们是根据5个交易日的数据计算的 被称为 5日简单移动平均线",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "u1hxQ0j3ETS6zb-C8n6jg",
      "type": "text",
      "x": 24893.215990070352,
      "y": 1449.1798531949626,
      "width": 456.3719787597656,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRw0",
