    },
    {
      "id": "57aVg8Gpl47jMjfVGt-Dw",
      "type": "text",
      "x": 7877.310162983244,
      "y": 187.10241553896913,
      "width": 585.5040283203125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
