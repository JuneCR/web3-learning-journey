      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "因为市场参与者正在抛售。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "因为市场参与者正在抛售。",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "zfE4ikq333itsGCmqzsjj",
      "type": "text",
      "x": 23276.33449045815,
      "y": 2992.88824971517,
      "width": 504,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
