      "text": "指标是用来辅助验证的，而不是做决策的唯一依\n据。新手建议只精通以下三个：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "指标是用来辅助验证的，而不是做决策的唯一依据。新手建议只精通以下三个：",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ruCU7cGFP0M6uy-OcTKJN",
      "type": "text",
      "x": 189.5500717163086,
      "y": 407.33331298828125,
      "width": 414.8999328613281,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
