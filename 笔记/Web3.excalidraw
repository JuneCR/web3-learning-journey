    },
    {
      "id": "ZMTydGE4Buus8OZ83Yr1J",
      "type": "text",
      "x": 8108.976673883106,
      "y": 3722.1026189894906,
      "width": 504,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
