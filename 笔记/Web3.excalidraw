    {
      "id": "0CWykx6dDr_5mFjrbekfU",
      "type": "text",
      "x": 19396.84764429125,
      "y": 860.8440944126703,
      "width": 1182.635986328125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
