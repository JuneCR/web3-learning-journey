      "versionNonce": 2017543689,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "如果纸伞出现在上升趋势的顶部，它就被称为“吊颈线”。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "如果纸伞出现在上升趋势的顶部，它就被称为“吊颈线”。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "MKX7UThZsI_zSzpiANSVT",
