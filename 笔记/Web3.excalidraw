      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Jwt_yNPU6AS7o0PlQzIZb",
      "type": "text",
      "x": 21085.47929454488,
      "y": 350.3660406798135,
      "width": 998.6667175292963,
      "height": 45,
      "angle": 0,
