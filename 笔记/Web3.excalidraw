    },
    {
      "id": "OK_snHu0P7ED_dCIxPFek",
      "type": "text",
      "x": 8021.330296319629,
      "y": 4062.380074637277,
      "width": 1252.5147399902346,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRqN",
      "roundness": null,
      "seed": 648456209,
      "version": 353,
      "versionNonce": 78700551,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "应该避免在K线幅度过小（低于1%）或过长（高于10%）时进行",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "应该避免在K线幅度过小（低于1%）或过长（高于10%）时进行",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "5DmBLZVixkCMjkNV13dvM",
      "type": "text",
      "x": 8011.309727471973,
      "y": 4351.547097342354,
      "width": 1618.666717529297,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "cRqO",
      "roundness": null,
      "seed": 581676241,
      "version": 494,
      "versionNonce": 55724009,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "短K线表明交易活动清淡，因此难以判断交易方向。相反，长K线则表明交易活动异常活跃。长K线的问\n题在于止损位的设置。止损位通常设置得很深，一旦交易失败，损失将非常巨大。因此，应避免在过\n短或过长的K线上进行交易。",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "短K线表明交易活动清淡，因此难以判断交易方向。相反，长K线则表明交易活动异常活跃。长K线的问题在于止损位的设置。止损位通常设置得很深，一旦交易失败，损失将非常巨大。因此，应避免在过短或过长的K线上进行交易。",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
