      "versionNonce": 384994663,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791795105057,
      "link": null,
      "locked": false,
      "text": "4.交易设置在锤子线的最低位作为止损点",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4.交易设置在锤子线的最低位作为止损点",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "zghZtTOankkrWsln8_MJg",
      "type": "text",
      "x": 12197.680753193254,
      "y": 3760.4551665290965,
      "width": 412.99200439453125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
