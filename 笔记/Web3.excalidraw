      "type": "text",
      "x": 19637.954404822507,
      "y": 6022.633595230873,
      "width": 835.6318969726562,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
