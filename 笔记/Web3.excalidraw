    {
      "id": "HJyBABdK1wc-oMQvWc5Mj",
      "type": "text",
      "x": 19202.069861851065,
      "y": 1491.2884812128004,
      "width": 72,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
