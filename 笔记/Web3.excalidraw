      "type": "text",
      "x": 12142.013832213426,
      "y": 4789.5664844815665,
      "width": 1106.9639892578125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
