    },
    {
      "id": "8W4w_A1PTxJgLkHA_gBeE",
      "type": "text",
      "x": 21306.89270273837,
      "y": 5474.991716657373,
      "width": 1087.0000000000002,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
