      "type": "text",
      "x": 19386.138918859888,
      "y": 4252.15453225504,
      "width": 990.9719848632812,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
